# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENSUBTITLES_API_KEY: Optional but strongly recommended. Enables the real-subtitle
# importer to search the official OpenSubtitles database instead of relying only on
# Archive.org and web search, which cover far fewer titles.
# Get a free key in ~2 minutes: https://www.opensubtitles.com/en/consumers -> "API" tab.
# Without this key, the app still works and never fabricates fake subtitles - it just
# finds real ones less often.
OPENSUBTITLES_API_KEY=""

# TMDB_API_KEY: Official TMDB v3 API key for posters, backdrops, logos, descriptions,
# cast/crew, seasons/episodes, and collections. Get a free one at
# https://www.themoviedb.org/settings/api. Without it the importer falls back to
# scraping TMDB's HTML pages directly, which is far more fragile.
TMDB_API_KEY=""
